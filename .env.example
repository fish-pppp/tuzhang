# Postgres — required on Vercel (Neon pooled URL recommended).
# Local / Grok preview: leave empty to use in-memory PGLite.
DATABASE_URL=

# Better Auth signing secret — required on Vercel.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of this app (no trailing slash).
# On Vercel you can omit this; the deployment URL is used automatically.
# Set it when you add a custom domain, e.g. https://tuzhang.example.com
BETTER_AUTH_URL=

# Leave unset (auth on). Set to "false" only for local no-login debugging.
# VITE_AUTH_ENABLED=true

# Optional: Grok auth broker (Google / X). Without these, use email + password.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
