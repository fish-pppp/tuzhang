# 复制成 .env 后按需修改：cp .env.example .env
# Vite 会自动读取 .env（服务端代码用 process.env，浏览器只能读 VITE_ 前缀）。

# ── 数据库 ─────────────────────────────────────────────────────────────────────
# 本地开发（推荐）：docker compose up -d 起一个 Postgres，然后用下面这条。
# 留空则退回内存版 PGLite：能跑，但重启 dev server 后账号和群组全部清空。
# 线上（Vercel）必填，推荐 Neon 的 pooled 连接串。
DATABASE_URL=postgres://tuzhang:tuzhang@127.0.0.1:5432/tuzhang

# ── 登录 ───────────────────────────────────────────────────────────────────────
# 会话签名密钥。本地随便写一串即可；线上必填且不要泄露：openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# 站点访问地址（不带末尾斜杠）。邮箱登录会校验浏览器 Origin 是否在白名单。
# 本地：http://localhost:8080 ；线上填用户实际打开的域名（绑了自定义域名就填自定义域名，不要只填 *.vercel.app）。
BETTER_AUTH_URL=http://localhost:8080

# 可选。额外信任的登录来源，逗号分隔。自定义域名和 Vercel 域名并存时用。
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com,https://example.com,https://your-app.vercel.app

# 默认开启登录。只有本地不想登录调试时才设成 false（此时不能同时配 DATABASE_URL）。
# VITE_AUTH_ENABLED=true

# ── 忘记密码（邮箱验证码）──────────────────────────────────────────────────────
# 发件人。配了 Resend 或 SMTP 时必填，例如：途账 <noreply@yourdomain.com>
# EMAIL_FROM=途账 <noreply@yourdomain.com>

# Vercel 推荐：Resend API Key（https://resend.com）。和 SMTP 同时配时走 Resend。
# RESEND_API_KEY=re_xxxxxxxx

# 或者用 SMTP（QQ / 163 / 阿里云直邮）。QQ/163 的密码填「授权码」不是登录密码。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@qq.com
# SMTP_PASS=

# 本地没配发信时，验证码会打到 dev server 终端。线上默认不会这样。
# EMAIL_OTP_ALLOW_LOG=true
